# Copy this file to .env for local development (`vercel dev` reads .env).
# In Vercel, add these as Project Environment Variables (Production and Preview).
# Never commit real values: this file is public.

# Supabase → Project Settings → API. Use the SECRET key (sb_secret_...), never the publishable one.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your-secret-key

# Any long random string, e.g. the output of: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Server-only assistant configuration. Never expose this in Vite client code.
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-5-mini

# Optional
# ALLOW_SIGNUPS=false            # close new sign-ups
# ASSISTANT_DAILY_LIMIT=200      # assistant messages per account per day
# OPENAI_REASONING_EFFORT=low    # low | medium (slower, more thorough)
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# Voice chats (talking with the assistant like a phone call)
# OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
# OPENAI_REALTIME_TRANSCRIBE_MODEL=gpt-transcribe
# VOICE_CHAT=off                 # turn new voice chats off for everyone (typing keeps working)

# Push notifications (reminders). Generate keys with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
# VAPID_SUBJECT=mailto:you@example.com   # optional; defaults to the site URL
# Random string; the Supabase scheduler sends it to /api/cron (see supabase/migrations/2026-09-24-notifications.sql)
CRON_SECRET=replace-with-a-long-random-string
